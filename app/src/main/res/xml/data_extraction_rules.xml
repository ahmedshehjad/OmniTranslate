<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not copy clipboard history to cloud backup. -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Do not copy clipboard history to another device during migration. -->
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
